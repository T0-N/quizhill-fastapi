# Lokalny Postgres z docker-compose (PostgreSQL 16, jak typowy Neon).
DATABASE_URL=postgresql+asyncpg://quizhill:quizhill@127.0.0.1:5432/quizhill

# W produkcji wstaw długi, losowy sekret.
JWT_SECRET=dev-change-me-please-use-32-bytes+
JWT_EXPIRE_MINUTES=43200

# Identyfikatory klientów OAuth Google (Web + Android), po przecinku.
# Bez nich logowanie Google w API nie zweryfikuje prawdziwego tokenu.
GOOGLE_CLIENT_IDS=

# true = testy i lokalny rozwój mogą logować bez Google (tylko gdy JWT i dev flag).
AUTH_DEV_MODE=true

# Hasło do bardzo prostego panelu /admin
ADMIN_PASSWORD=quizhill

# Po starcie uzupełnij pustą bazę przykładowymi quizami z aplikacji.
SEED_ON_EMPTY=true
